{
  "manifest_version": 3,
  "browser_specific_settings": {
    "gecko": {
      "id": "material-you@thunderbird.local",
      "strict_min_version": "128.0"
    }
  },
  "name": "Material You for Thunderbird",
  "description": "A Material 3 inspired light and dark theme with tonal surfaces, rounded controls, and clear selection states.",
  "version": "0.1.4",
  "icons": {
    "32": "icon.svg"
  },
  "theme_experiment": {
    "stylesheet": "material.css",
    "colors": {
      "md3_primary": "--md3-primary",
      "md3_on_primary": "--md3-on-primary",
      "md3_primary_container": "--md3-primary-container",
      "md3_on_primary_container": "--md3-on-primary-container",
      "md3_surface": "--md3-surface",
      "md3_surface_low": "--md3-surface-low",
      "md3_surface_container": "--md3-surface-container",
      "md3_surface_high": "--md3-surface-high",
      "md3_on_surface": "--md3-on-surface",
      "md3_on_surface_variant": "--md3-on-surface-variant",
      "md3_outline": "--md3-outline",
      "md3_outline_variant": "--md3-outline-variant"
    },
    "properties": {
      "md3_card_radius": "--listbox-border-radius"
    }
  },
  "theme": {
    "colors": {
      "frame": "#F7F2FA",
      "frame_inactive": "#F3EDF7",
      "tab_background_text": "#49454F",
      "tab_selected": "#FEF7FF",
      "tab_text": "#1D1B20",
      "tab_line": "#6750A4",
      "tab_loading": "#6750A4",
      "toolbar": "#FEF7FF",
      "toolbar_text": "#1D1B20",
      "icons": "#49454F",
      "icons_attention": "#6750A4",
      "toolbar_field": "#F3EDF7",
      "toolbar_field_text": "#1D1B20",
      "toolbar_field_border": "#CAC4D0",
      "toolbar_field_focus": "#FEF7FF",
      "toolbar_field_text_focus": "#1D1B20",
      "toolbar_field_border_focus": "#6750A4",
      "toolbar_field_highlight": "#EADDFF",
      "toolbar_field_highlight_text": "#21005D",
      "toolbar_top_separator": "#E7E0EC",
      "toolbar_bottom_separator": "#E7E0EC",
      "toolbar_vertical_separator": "#E7E0EC",
      "button_background_hover": "#ECE6F0",
      "button_background_active": "#E8DEF8",
      "sidebar": "#F7F2FA",
      "sidebar_text": "#1D1B20",
      "sidebar_border": "#E7E0EC",
      "sidebar_highlight": "#EADDFF",
      "sidebar_highlight_text": "#21005D",
      "sidebar_highlight_border": "#D0BCFF",
      "popup": "#F9F6FC",
      "popup_text": "#1D1B20",
      "popup_border": "#CAC4D0",
      "popup_highlight": "#E8DEF8",
      "popup_highlight_text": "#1D192B",
      "md3_primary": "#6750A4",
      "md3_on_primary": "#FFFFFF",
      "md3_primary_container": "#EADDFF",
      "md3_on_primary_container": "#21005D",
      "md3_surface": "#FEF7FF",
      "md3_surface_low": "#F7F2FA",
      "md3_surface_container": "#F3EDF7",
      "md3_surface_high": "#ECE6F0",
      "md3_on_surface": "#1D1B20",
      "md3_on_surface_variant": "#49454F",
      "md3_outline": "#79747E",
      "md3_outline_variant": "#CAC4D0"
    },
    "properties": {
      "color_scheme": "light",
      "content_color_scheme": "light",
      "md3_card_radius": "14px"
    }
  },
  "dark_theme": {
    "colors": {
      "frame": "#1D1B20",
      "frame_inactive": "#141218",
      "tab_background_text": "#CAC4D0",
      "tab_selected": "#2B2930",
      "tab_text": "#E6E0E9",
      "tab_line": "#D0BCFF",
      "tab_loading": "#D0BCFF",
      "toolbar": "#211F26",
      "toolbar_text": "#E6E0E9",
      "icons": "#CAC4D0",
      "icons_attention": "#D0BCFF",
      "toolbar_field": "#2B2930",
      "toolbar_field_text": "#E6E0E9",
      "toolbar_field_border": "#49454F",
      "toolbar_field_focus": "#36343B",
      "toolbar_field_text_focus": "#E6E0E9",
      "toolbar_field_border_focus": "#D0BCFF",
      "toolbar_field_highlight": "#4F378B",
      "toolbar_field_highlight_text": "#EADDFF",
      "toolbar_top_separator": "#49454F",
      "toolbar_bottom_separator": "#49454F",
      "toolbar_vertical_separator": "#49454F",
      "button_background_hover": "#36343B",
      "button_background_active": "#4F378B",
      "sidebar": "#1D1B20",
      "sidebar_text": "#E6E0E9",
      "sidebar_border": "#49454F",
      "sidebar_highlight": "#4F378B",
      "sidebar_highlight_text": "#EADDFF",
      "sidebar_highlight_border": "#D0BCFF",
      "popup": "#2B2930",
      "popup_text": "#E6E0E9",
      "popup_border": "#49454F",
      "popup_highlight": "#4A4458",
      "popup_highlight_text": "#E8DEF8",
      "md3_primary": "#D0BCFF",
      "md3_on_primary": "#381E72",
      "md3_primary_container": "#4F378B",
      "md3_on_primary_container": "#EADDFF",
      "md3_surface": "#141218",
      "md3_surface_low": "#1D1B20",
      "md3_surface_container": "#211F26",
      "md3_surface_high": "#2B2930",
      "md3_on_surface": "#E6E0E9",
      "md3_on_surface_variant": "#CAC4D0",
      "md3_outline": "#938F99",
      "md3_outline_variant": "#49454F"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "dark",
      "md3_card_radius": "14px"
    }
  }
}
